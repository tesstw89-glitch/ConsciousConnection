    private func loadSavedKitchen() {
        guard !isLoaded else { return }
        isLoaded = true
        if let data = savedFoods.data(using: .utf8),
           let foods = try? JSONDecoder().decode([KitchenFood].self, from: data) {
            extraFoods = foods
        }
        if inventorySetUp {
            if let data = savedSelection.data(using: .utf8),
               let keys = try? JSONDecoder().decode([String].self, from: data) {
                selected = Set(keys)
            }
        } else {
            selected = Set(allFoods.map { Self.foodKey($0.name) })
            inventorySetUp = true
            saveSelectedFoods()
        }
    }

    static func foodKey(_ value: String) -> String {
        let simplified = value.lowercased().filter { $0.isLetter || $0.isNumber }
        switch simplified {
        case "egg", "eggs": return "eggs"
        case "tenderstembroccoli", "tenderstembrokoli": return "tenderstembroccoli"
        case "tintomatoes", "tinnedtomatoes": return "tinnedtomatoes"
        default: return simplified
        }
    }

    private func addIngredient() {
        let name = newIngredient.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !name.isEmpty else { return }
        let brand = newBrand.trimmingCharacters(in: .whitespacesAndNewlines)
        let candidate = KitchenFood(name: name, area: addTo,
                                    brand: brand.isEmpty ? nil : brand)
        if let existing = allFoods.first(where: { $0.id == candidate.id }) {
            selected.insert(existing.id)
            step = existing.area.step
        } else {
            extraFoods.append(candidate)
            selected.insert(candidate.id)
            step = addTo.step
            saveCustomFoods()
        }
        saveSelectedFoods()
        if !brand.isEmpty {
            NutritionBrandedLibrary.save(NutritionSavedProduct(name: name, brand: brand))
        }
        newIngredient = ""
        newBrand = ""
    }

    private func addOpenFoodFactsProduct(_ product: OpenFoodFactsKitchenProduct) {
        let candidate = KitchenFood(name: product.name, area: addTo,
                                    brand: product.brand, barcode: product.id,
                                    nutrition: product.nutrition)
        if let existing = allFoods.first(where: { $0.id == candidate.id }) {
            selected.insert(existing.id)
            step = existing.area.step
        } else {
            extraFoods.append(candidate)
            selected.insert(candidate.id)
            step = addTo.step
            saveCustomFoods()
        }
        saveSelectedFoods()
        NutritionBrandedLibrary.save(.fromProduct(name: product.name, brand: product.brand,
            barcode: product.id, nutriments: product.nutrition?.asRawNutrients))
        showingProductSearch = false
    }

    @MainActor
    private func addScannedKitchenProduct(_ code: String) async {
        guard !scanningKitchenProduct else { return }
        scanningKitchenProduct = true
        kitchenBarcodeFeedback = nil
        defer { scanningKitchenProduct = false }
        do {
            let product = try await MealBarcodeProducts.lookup(code)
            let wasPresent = allFoods.contains { $0.barcode == product.barcode }
            NutritionBrandedLibrary.save(.fromProduct(name: product.name, brand: product.brand,
                barcode: product.barcode, nutriments: product.nutriments,
                productFields: product.rawProduct))
            addOpenFoodFactsProduct(OpenFoodFactsKitchenProduct(
                id: product.barcode, name: product.name, brand: product.brand,
                nutrition: product.nutriments.map { KitchenNutrients(raw: $0) }
            ))
            kitchenBarcodeFeedback = wasPresent
                ? "Already in your kitchen — selected \(product.name)."
                : "Added \(product.name) to \(addTo.rawValue)."
        } catch {
            kitchenBarcodeError = error.localizedDescription
            showingKitchenBarcodeError = true
        }
    }

    private func removeCustomFood(_ food: KitchenFood) {
        let key = food.id
        extraFoods.removeAll { $0.id == key }
        selected.remove(key)
        saveCustomFoods()
        saveSelectedFoods()
    }

    private var filteredLocalBrandedFoods: [NutritionSavedProduct] {
        let query = productQuery.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !query.isEmpty else { return localBrandedFoods }
        return localBrandedFoods.filter {
            $0.displayName.localizedStandardContains(query) ||
            ($0.barcode?.contains(query) ?? false)
        }
    }

    private func addSavedBrandedFood(_ product: NutritionSavedProduct) {
        let candidate = KitchenFood(name: product.name, area: addTo, brand: product.brand,
            barcode: product.barcode, nutrition: KitchenNutrients(raw: product.rawNutriments()))
        if let existing = allFoods.first(where: { $0.id == candidate.id }) {
            selected.insert(existing.id)
            step = existing.area.step
        } else {
            extraFoods.append(candidate)
            selected.insert(candidate.id)
            step = addTo.step
            saveCustomFoods()
        }
        saveSelectedFoods()
        showingProductSearch = false
    }

    private var productSearchSheet: some View {
        NavigationStack {
            VStack(alignment: .leading, spacing: 12) {
                Text(searchingOnlineFoods
                     ? "Discover a new product on Open Food Facts. This needs an internet connection."
                     : "Your saved branded foods appear as you type — no internet needed.")
                    .font(.subheadline)
                    .foregroundStyle(.secondary)

                HStack(spacing: 8) {
                    TextField(searchingOnlineFoods ? "e.g. Weetabix Original" : "Search my saved foods", text: $productQuery)
                        .textInputAutocapitalization(.words)
                        .autocorrectionDisabled()
                        .submitLabel(.search)
                        .onSubmit { if searchingOnlineFoods { searchOpenFoodFacts() } }
                        .textFieldStyle(.roundedBorder)
                    if searchingOnlineFoods {
                        Button("Search") { searchOpenFoodFacts() }
                            .disabled(searchingProducts || productQuery.trimmingCharacters(in: .whitespacesAndNewlines).count < 2)
                            .buttonStyle(.borderedProminent)
                    }
                }

                Picker("Store in", selection: $addTo) {
                    ForEach(KitchenArea.allCases, id: \.self) { area in
                        Text(area.rawValue).tag(area)
                    }
                }
                .pickerStyle(.menu)

                Button {
                    searchingOnlineFoods.toggle()
                    productSearchError = nil
                    productResults = []
                    if !searchingOnlineFoods { localBrandedFoods = NutritionBrandedLibrary.loadWithMigration() }
                } label: {
                    Label(searchingOnlineFoods ? "Back to my saved foods" : "Search Open Food Facts for a new product",
                          systemImage: searchingOnlineFoods ? "clock.arrow.circlepath" : "globe")
                        .font(.subheadline.weight(.semibold))
                }
                .disabled(searchingProducts || fetchingProduct)

                if searchingOnlineFoods {
                    if searchingProducts { ProgressView("Looking for products…") }
                    if fetchingProduct { ProgressView("Fetching up-to-date nutrient details…") }
                    if let productSearchError { Text(productSearchError).font(.footnote).foregroundStyle(.secondary) }
                    List(productResults) { product in
                        Button {
                            Task { await addProductWithLatestNutrition(product) }
                        } label: {
                            VStack(alignment: .leading, spacing: 5) {
                                Text(product.displayName).font(.headline).foregroundStyle(.primary)
                                Text(product.nutrition?.summary ?? "Nutrient details checked on selection")
                                    .font(.caption).foregroundStyle(.secondary)
                            }
                        }
                        .disabled(fetchingProduct)
                    }
                    .listStyle(.plain)
                } else {
                    if filteredLocalBrandedFoods.isEmpty {
                        ContentUnavailableView("No saved products found", systemImage: "tray",
                            description: Text("Use Search Open Food Facts or scan a barcode to save your first branded product."))
                    }
                    List(filteredLocalBrandedFoods) { product in
                        Button { addSavedBrandedFood(product) } label: {
                            VStack(alignment: .leading, spacing: 5) {
                                Text(product.displayName).font(.headline).foregroundStyle(.primary)
                                if !product.nutritionDetails.isEmpty {
                                    Text("Reported per 100 g / 100 ml: \(product.nutritionDetails)")
                                        .font(.caption).foregroundStyle(.secondary)
                                }
                                if let serving = product.servingSizeText, !serving.isEmpty {
                                    Text("Label serving: \(serving)").font(.caption2).foregroundStyle(.secondary)
                                }
                            }
                        }
                    }
                    .listStyle(.plain)
                }
                Link("Product data: Open Food Facts contributors (ODbL)",
                     destination: URL(string: "https://world.openfoodfacts.org/terms-of-use")!)
                    .font(.caption2).foregroundStyle(.secondary)
                Text("Saved locally on this iPhone. Nutrient fields are included only when provided; no calories tracked.")
                    .font(.caption2).foregroundStyle(.secondary)
            }
            .padding(16)
            .navigationTitle(searchingOnlineFoods ? "Search Open Food Facts" : "My saved branded foods")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .topBarTrailing) {
                    Button("Done") { showingProductSearch = false }
                }
            }
            .onAppear { localBrandedFoods = NutritionBrandedLibrary.loadWithMigration() }
        }
    }

    // Use Search-a-licious for text search; the legacy /cgi/search.pl service
    // intermittently returns 503. Product details are refreshed by barcode on selection.
    // Search only on explicit tap; never per keystroke.
    private func searchOpenFoodFacts() {
        let query = productQuery.trimmingCharacters(in: .whitespacesAndNewlines)
        guard query.count >= 2, !searchingProducts, !fetchingProduct else { return }
        let cacheKey = query.lowercased()
        if let cached = productCache[cacheKey] {
            productResults = cached
            productSearchError = cached.isEmpty ? "No products found for that search. You can still add it manually." : nil
            return
        }

        let now = Date()
        searchHistory = searchHistory.filter { now.timeIntervalSince($0) < 60 }
        guard searchHistory.count < 8 else {
            productSearchError = "Please wait a minute before searching again. You can still add an ingredient manually."
            return
        }
        searchHistory.append(now)
        productResults = []
        productSearchError = nil
        searchingProducts = true

        var components = URLComponents(string: "https://search.openfoodfacts.org/search")!
        components.queryItems = [
            URLQueryItem(name: "q", value: query),
            URLQueryItem(name: "page_size", value: "12"),
            URLQueryItem(name: "langs", value: "en"),
            URLQueryItem(name: "fields", value: "code,product_name,brands")
        ]
        guard let url = components.url else {
            searchingProducts = false
            productSearchError = "Could not create the product search request."
            return
        }
        var request = URLRequest(url: url)
        request.timeoutInterval = 20
        request.setValue("ConsciousConnection/1.0 (https://github.com/tesstw89-glitch/ConsciousConnection)",
                         forHTTPHeaderField: "User-Agent")
        request.setValue("application/json", forHTTPHeaderField: "Accept")

        Task {
            do {
                let (data, response) = try await URLSession.shared.data(for: request)
                guard let http = response as? HTTPURLResponse else {
                    throw NSError(domain: "ConsciousConnectionFoodSearch", code: -1,
                                  userInfo: [NSLocalizedDescriptionKey: "The food service did not return an HTTP response."])
                }
                guard (200...299).contains(http.statusCode) else {
                    let explanation: String
                    switch http.statusCode {
                    case 403: explanation = "Open Food Facts denied the search request (HTTP 403)."
                    case 429: explanation = "Open Food Facts is rate-limiting searches (HTTP 429). Please try later."
                    case 500...599: explanation = "Open Food Facts' search service is temporarily unavailable (HTTP \(http.statusCode))."
                    default: explanation = "Open Food Facts returned HTTP \(http.statusCode)."
                    }
                    throw NSError(domain: "ConsciousConnectionFoodSearch", code: http.statusCode,
                                  userInfo: [NSLocalizedDescriptionKey: explanation])
                }
                guard let json = try JSONSerialization.jsonObject(with: data) as? [String: Any],
                      let hits = json["hits"] as? [[String: Any]] else {
                    throw NSError(domain: "ConsciousConnectionFoodSearch", code: -2,
                                  userInfo: [NSLocalizedDescriptionKey: "Unexpected search response. The service may have changed its format."])
                }
                func fieldText(_ value: Any?) -> String {
                    if let text = value as? String { return text.trimmingCharacters(in: .whitespacesAndNewlines) }
                    if let multilingual = value as? [String: Any] {
                        let ordered = ["en", "en-gb", "en_GB"]
                        for lang in ordered {
                            if let result = multilingual[lang] as? String, !result.isEmpty { return result }
                        }
                        if let result = multilingual.values.compactMap({ $0 as? String }).first { return result }
                    }
                    return ""
                }
                var seen = Set<String>()
                let products: [OpenFoodFactsKitchenProduct] = hits.compactMap { hit in
                    let record = (hit["_source"] as? [String: Any]) ?? hit
                    let barcode = fieldText(record["code"])
                    guard !barcode.isEmpty, barcode.count <= 20,
                          barcode.unicodeScalars.allSatisfy({ CharacterSet.decimalDigits.contains($0) }),
                          seen.insert(barcode).inserted else { return nil }
                    let name = fieldText(record["product_name_en"]).isEmpty
                        ? fieldText(record["product_name"]) : fieldText(record["product_name_en"])
                    guard !name.isEmpty else { return nil }
                    let brand = fieldText(record["brands"])
                    return OpenFoodFactsKitchenProduct(id: barcode,
                                                       name: name,
                                                       brand: brand.isEmpty ? nil : brand,
                                                       nutrition: nil)
                }
                await MainActor.run {
                    productResults = products
                    productCache[cacheKey] = products
                    productSearchError = products.isEmpty
                        ? "No matching products found. The Open Food Facts search catalogue may be incomplete; try a shorter name or add it manually."
                        : nil
                    searchingProducts = false
                }
            } catch {
                await MainActor.run {
                    if let urlError = error as? URLError {
                        productSearchError = "Couldn't reach Open Food Facts (network error \(urlError.code.rawValue)). Check your connection or try again later."
                    } else {
                        productSearchError = error.localizedDescription
                    }
                    searchingProducts = false
                }
            }
        }
    }

    // The text index is not necessarily current; fetch the latest public product
    // record from the canonical barcode API before saving its nutrient values.
    @MainActor
    private func addProductWithLatestNutrition(_ searchResult: OpenFoodFactsKitchenProduct) async {
        guard !fetchingProduct else { return }
        fetchingProduct = true
        defer { fetchingProduct = false }
        var product = searchResult
        if let url = URL(string: "https://world.openfoodfacts.org/api/v2/product/\(searchResult.id).json?fields=code,product_name,brands,nutriments,serving_size,serving_quantity,serving_quantity_unit,product_quantity_unit") {
            var request = URLRequest(url: url)
            request.timeoutInterval = 15
            request.setValue("ConsciousConnection/1.0 (https://github.com/tesstw89-glitch/ConsciousConnection)",
                             forHTTPHeaderField: "User-Agent")
            request.setValue("application/json", forHTTPHeaderField: "Accept")
            do {
                let (data, response) = try await URLSession.shared.data(for: request)
                if let http = response as? HTTPURLResponse,
                   (200...299).contains(http.statusCode),
                   let json = try JSONSerialization.jsonObject(with: data) as? [String: Any],
                   let current = json["product"] as? [String: Any] {
                    let rawNutrients = current["nutriments"] as? [String: Any]
                    NutritionBrandedLibrary.save(.fromProduct(name: searchResult.name,
                        brand: searchResult.brand, barcode: searchResult.id,
                        nutriments: rawNutrients, productFields: current))
                    let nutrients = rawNutrients.map { KitchenNutrients(raw: $0) }
                    // Keep the name and brand the user selected in the search results.
                    product = OpenFoodFactsKitchenProduct(id: searchResult.id,
                                                          name: searchResult.name,
                                                          brand: searchResult.brand,
                                                          nutrition: nutrients)
                }
            } catch {
                // The user's selected food still saves, without invented nutrient data.
                print("Nutrition: latest product nutrient data unavailable: \(error.localizedDescription)")
            }
        }
        addOpenFoodFactsProduct(product)
    }

    private func saveCustomFoods() {
        if let data = try? JSONEncoder().encode(extraFoods),
           let text = String(data: data, encoding: .utf8) {
            savedFoods = text
        }
    }

    private func saveSelectedFoods() {
        if let data = try? JSONEncoder().encode(Array(selected).sorted()),
           let text = String(data: data, encoding: .utf8) {
            savedSelection = text
        }
    }

    private func discussWithChatGPT() {
        let lines = KitchenArea.allCases.compactMap { area -> String? in
            let names = allFoods.filter {
                $0.area == area && selected.contains($0.id)
            }.map { food -> String in
                var label = food.displayName
                if let nutrition = food.nutrition, !nutrition.summary.isEmpty {
                    label += " [Open Food Facts reported nutrients, approx. per 100g/100ml: " + nutrition.summary + "]"
                }
                return label
            }
            guard !names.isEmpty else { return nil }
            return "\(area.rawValue): \(names.joined(separator: ", "))"
        }
        guard !lines.isEmpty else { return }

        let cookingInstruction = energy == .quick
            ? "I need something quick and easy: minimal preparation, few ingredients and as little washing-up as possible."
            : "I've got time to cook: feel free to suggest something more involved or creative."
        let note = additionalNotes.trimmingCharacters(in: .whitespacesAndNewlines)
        let noteText = note.isEmpty ? "" : "\n\nMy extra note: \(note)"

        let message = """
        I'd like help making a nutritious \(meal.rawValue.lowercased()) using food I already have.

        Here is what I have available right now:
        \(lines.joined(separator: "\n"))

        My nutritional priorities are protein, steady-release carbohydrates, magnesium, vitamin B12 and iron. Please include as many of these as practical, but even one is worthwhile. I want a satisfying meal, not a restrictive diet.

        \(cookingInstruction)\(noteText)

        Please suggest two or three realistic meals using what I have. Explain briefly which of my nutritional priorities each option supports. Don't assume I have extra ingredients. Branded-product nutrient data may be incomplete or outdated: treat missing nutrients as unknown, not zero, and don't invent exact amounts. Ask me a helpful question if it would make choosing easier.
        """

        UIPasteboard.general.string = message
        additionalNotes = ""
        guard let url = URL(string: "chatgpt://") else {
            showAppError = true
            return
        }
        UIApplication.shared.open(url, options: [:]) { success in
            if !success {
                DispatchQueue.main.async { showAppError = true }
            }
        }
    }
}

private extension View {
    func nutritionPanel() -> some View {
        self.padding(17)
            .frame(maxWidth: .infinity, alignment: .leading)
            .background(Color.black.opacity(0.59), in: RoundedRectangle(cornerRadius: 20))
            .overlay {
                RoundedRectangle(cornerRadius: 20)
                    .stroke(Color.white.opacity(0.24), lineWidth: 1)
            }
    }

    func nutritionChoice(isActive: Bool) -> some View {
        self.font(.system(size: 13, weight: .semibold))
            .foregroundStyle(.white)
            .frame(maxWidth: .infinity)
            .padding(.vertical, 12)
            .background(
                isActive ? Color(red: 0.11, green: 0.48, blue: 0.40) : Color.white.opacity(0.14),
                in: RoundedRectangle(cornerRadius: 11)
            )
            .buttonStyle(.plain)
    }
}
