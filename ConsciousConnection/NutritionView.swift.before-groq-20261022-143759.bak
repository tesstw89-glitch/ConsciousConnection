import SwiftUI
import UIKit

// Nutrition lives in the main ConsciousConnection app, sharing its navigation stack.
private enum KitchenArea: String, Codable, CaseIterable, Hashable {
    case essentials = "Essentials"
    case fridge = "Fridge & Freezer"
    case cupboard = "Cupboard"

    var step: Int {
        switch self {
        case .essentials: return 0
        case .fridge: return 1
        case .cupboard: return 2
        }
    }
}

private struct KitchenFood: Codable, Identifiable {
    var name: String
    var area: KitchenArea
    var brand: String? = nil
    var barcode: String? = nil
    var nutrition: KitchenNutrients? = nil

    var id: String {
        if let barcode, !barcode.isEmpty { return "off:" + barcode }
        let names = [brand, name].compactMap { $0 }.joined(separator: " ")
        return NutritionView.foodKey(names)
    }

    var displayName: String {
        guard let brand, !brand.trimmingCharacters(in: .whitespaces).isEmpty else {
            return name
        }
        if name.lowercased().hasPrefix(brand.lowercased()) { return name }
        return "\(brand) \(name)"
    }
}

// Only nutrients relevant to this feature; no calorie fields.
private struct KitchenNutrients: Codable {
    var proteinG: Double? = nil
    var fibreG: Double? = nil
    var carbohydrateG: Double? = nil
    var ironMg: Double? = nil
    var magnesiumMg: Double? = nil
    var b12Micrograms: Double? = nil

    init(raw: [String: Any]) {
        func number(_ key: String) -> Double? {
            if let value = raw[key] as? NSNumber { return value.doubleValue }
            if let value = raw[key] as? String { return Double(value) }
            return nil
        }
        proteinG = number("proteins_100g")
        fibreG = number("fiber_100g")
        carbohydrateG = number("carbohydrates_100g")
        // OFF standardizes micronutrients in grams. Convert to familiar units.
        ironMg = number("iron_100g").map { $0 * 1_000 }
        magnesiumMg = number("magnesium_100g").map { $0 * 1_000 }
        b12Micrograms = number("vitamin-b12_100g").map { $0 * 1_000_000 }
    }

    var asRawNutrients: [String: Any] {
        var result: [String: Any] = [:]
        if let proteinG { result["proteins_100g"] = proteinG }
        if let fibreG { result["fiber_100g"] = fibreG }
        if let carbohydrateG { result["carbohydrates_100g"] = carbohydrateG }
        if let ironMg { result["iron_100g"] = ironMg / 1000 }
        if let magnesiumMg { result["magnesium_100g"] = magnesiumMg / 1000 }
        if let b12Micrograms { result["vitamin-b12_100g"] = b12Micrograms / 1_000_000 }
        return result
    }

    var summary: String {
        var parts: [String] = []
        if let proteinG { parts.append(String(format: "protein %.1f g", proteinG)) }
        if let fibreG { parts.append(String(format: "fibre %.1f g", fibreG)) }
        if let carbohydrateG { parts.append(String(format: "carbs %.1f g", carbohydrateG)) }
        if let ironMg { parts.append(String(format: "iron %.2f mg", ironMg)) }
        if let magnesiumMg { parts.append(String(format: "magnesium %.1f mg", magnesiumMg)) }
        if let b12Micrograms { parts.append(String(format: "B12 %.2f µg", b12Micrograms)) }
        return parts.joined(separator: ", ")
    }
}

private struct OpenFoodFactsKitchenProduct: Identifiable {
    let id: String // EAN/UPC barcode
    let name: String
    let brand: String?
    let nutrition: KitchenNutrients?

    var displayName: String {
        guard let brand, !brand.isEmpty, !name.lowercased().hasPrefix(brand.lowercased()) else {
            return name
        }
        return "\(brand) \(name)"
    }
}

private enum EatingMoment: String, CaseIterable {
    case breakfast = "Breakfast"
    case lunch = "Lunch"
    case dinner = "Dinner"
}

private enum CookingEnergy: String, CaseIterable {
    case quick = "Quick & easy"
    case cook = "I've got time to cook"
}

