import SwiftUI
import UIKit

// Nutrition lives in the main ConsciousConnection app, sharing its navigation stack.
private enum KitchenArea: String, Codable, CaseIterable, Hashable {
    case essentials = "Essentials"
    case fridge = "Fridge & Freezer"
    case cupboard = "Cupboard"

    var step: Int {
        switch self {
        case .essentials: return 0
        case .fridge: return 1
        case .cupboard: return 2
        }
    }
}

private struct KitchenFood: Codable, Identifiable {
    var name: String
    var area: KitchenArea
    var id: String { NutritionView.foodKey(name) }
}

private enum EatingMoment: String, CaseIterable {
    case breakfast = "Breakfast"
    case lunch = "Lunch"
    case dinner = "Dinner"
}

private enum CookingEnergy: String, CaseIterable {
    case quick = "Quick & easy"
    case cook = "I've got time to cook"
}

struct NutritionView: View {
    @AppStorage("nutrition.userFoods.v1") private var savedFoods = ""
    @AppStorage("nutrition.selectedFoods.v1") private var savedSelection = ""
    @AppStorage("nutrition.inventorySetUp.v1") private var inventorySetUp = false

    @State private var extraFoods: [KitchenFood] = []
    @State private var selected: Set<String> = []
    @State private var isLoaded = false
    @State private var step = 0
    @State private var newIngredient = ""
    @State private var addTo: KitchenArea = .fridge
    @State private var meal: EatingMoment = .lunch
    @State private var energy: CookingEnergy = .quick
    @State private var additionalNotes = ""
    @State private var showAppError = false

    // Your initial kitchen inventory, from your own list of ingredients.
    private static let startingFoods: [KitchenFood] = [
        .init(name: "Milk", area: .essentials),
        .init(name: "Eggs", area: .essentials),
        .init(name: "Cereal", area: .essentials),
        .init(name: "Bread", area: .essentials),
        .init(name: "Pasta", area: .essentials),
        .init(name: "Basmati rice", area: .essentials),
        .init(name: "Long-grain rice", area: .essentials),
        .init(name: "Jasmine rice", area: .essentials),
        .init(name: "Broccoli", area: .fridge),
        .init(name: "Tenderstem broccoli", area: .fridge),
        .init(name: "Pancetta", area: .fridge),
        .init(name: "Parmesan", area: .fridge),
        .init(name: "Double cream", area: .fridge),
        .init(name: "Stilton", area: .fridge),
        .init(name: "Bacon", area: .fridge),
        .init(name: "Spring onions", area: .fridge),
        .init(name: "Rosemary", area: .fridge),
        .init(name: "Frozen banana", area: .fridge),
        .init(name: "Frozen peas", area: .fridge),
        .init(name: "Frozen avocado", area: .fridge),
        .init(name: "Frozen scampi", area: .fridge),
        .init(name: "Frozen fries", area: .fridge),
        .init(name: "Sweet potato", area: .cupboard),
        .init(name: "New potatoes", area: .cupboard),
        .init(name: "Maris Piper potatoes", area: .cupboard),
        .init(name: "Onions", area: .cupboard),
        .init(name: "Shallots", area: .cupboard),
        .init(name: "Sun-dried tomato pesto", area: .cupboard),
        .init(name: "Tinned tomatoes", area: .cupboard),
        .init(name: "Tinned lentils", area: .cupboard)
    ]

    private var allFoods: [KitchenFood] { Self.startingFoods + extraFoods }

    var body: some View {
        GeometryReader { geo in
            ZStack {
                Image("Meal_Background")
                    .resizable()
                    .scaledToFill()
                    .frame(width: geo.size.width, height: geo.size.height)
                    .clipped()
                    .ignoresSafeArea()

                Color.black.opacity(0.46)
                    .ignoresSafeArea()

                ScrollView {
                    VStack(alignment: .leading, spacing: 20) {
                        VStack(alignment: .leading, spacing: 7) {
                            Text("NOURISH")
                                .font(.system(size: 13, weight: .bold, design: .rounded))
                                .tracking(3)
                                .foregroundStyle(.white.opacity(0.75))

                            Text("What have we got to eat?")
                                .font(.system(size: 30, weight: .semibold, design: .rounded))
                                .foregroundStyle(.white)

                            Text("Use what you have. Make something satisfying and nutritious.")
                                .font(.subheadline)
                                .foregroundStyle(.white.opacity(0.82))
                        }

                        addFoodPanel

                        HStack {
                            Text("STEP \(step + 1) OF 4")
                                .font(.caption.weight(.bold))
                                .foregroundStyle(.white.opacity(0.80))
                            Spacer()
                            Text(stepTitle)
                                .font(.caption.weight(.semibold))
                                .foregroundStyle(.white)
                        }

                        Group {
                            if step < 3 {
                                ingredientPanel(area: KitchenArea.allCases[step])
                            } else {
                                mealPreferencesPanel
                            }
                        }

                        HStack(spacing: 12) {
                            if step > 0 {
                                Button {
                                    withAnimation(.easeInOut(duration: 0.2)) { step -= 1 }
                                } label: {
                                    Text("Back")
                                        .frame(maxWidth: .infinity)
                                        .padding(.vertical, 15)
                                }
                                .buttonStyle(.plain)
                                .foregroundStyle(.white)
                                .background(Color.black.opacity(0.58), in: RoundedRectangle(cornerRadius: 14))
                            }

                            Button {
                                if step < 3 {
                                    withAnimation(.easeInOut(duration: 0.2)) { step += 1 }
                                } else {
                                    discussWithChatGPT()
                                }
                            } label: {
                                HStack(spacing: 8) {
                                    Text(step == 3 ? "Ask ChatGPT" : "Continue")
                                    Image(systemName: step == 3 ? "bubble.left.and.bubble.right" : "arrow.right")
                                }
                                .frame(maxWidth: .infinity)
                                .padding(.vertical, 15)
                            }
                            .buttonStyle(.plain)
                            .fontWeight(.semibold)
                            .foregroundStyle(.white)
                            .background(Color(red: 0.12, green: 0.43, blue: 0.37), in: RoundedRectangle(cornerRadius: 14))
                            .disabled(step == 3 && selected.isEmpty)
                            .opacity(step == 3 && selected.isEmpty ? 0.5 : 1)
                        }
                    }
                    .padding(.horizontal, 20)
                    .padding(.top, 25)
                    .padding(.bottom, 70)
                }
            }
        }
        .navigationTitle("Nutrition")
        .navigationBarTitleDisplayMode(.inline)
        .onAppear(perform: loadSavedKitchen)
        .alert("Open ChatGPT on your iPhone", isPresented: $showAppError) {
            Button("OK", role: .cancel) { }
        } message: {
            Text("Your meal request is already copied. Please open the ChatGPT app and paste it. If needed, install the ChatGPT app first.")
        }
    }

    private var stepTitle: String {
        step == 3 ? "Your meal" : KitchenArea.allCases[step].rawValue
    }

    private var addFoodPanel: some View {
        VStack(alignment: .leading, spacing: 12) {
            Label("Add an ingredient", systemImage: "plus.circle.fill")
                .font(.headline)
                .foregroundStyle(.white)

            HStack(spacing: 8) {
                TextField("Type or dictate an ingredient", text: $newIngredient)
                    .textInputAutocapitalization(.words)
                    .autocorrectionDisabled(false)
                    .submitLabel(.done)
                    .onSubmit(addIngredient)
                    .padding(12)
                    .background(Color.white.opacity(0.95), in: RoundedRectangle(cornerRadius: 12))
                    .foregroundStyle(.black)

                Button(action: addIngredient) {
                    Image(systemName: "plus")
                        .font(.headline.weight(.bold))
                        .frame(width: 44, height: 44)
                }
                .buttonStyle(.plain)
                .foregroundStyle(.white)
                .background(Color.white.opacity(0.22), in: RoundedRectangle(cornerRadius: 12))
                .accessibilityLabel("Add ingredient")
            }

            Menu {
                ForEach(KitchenArea.allCases, id: \.self) { area in
                    Button(area.rawValue) { addTo = area }
                }
            } label: {
                Label("Add to: \(addTo.rawValue)", systemImage: "chevron.down")
                    .font(.footnote.weight(.medium))
                    .foregroundStyle(.white.opacity(0.90))
            }

            Text("You can use your keyboard's microphone. Existing ingredients won't be duplicated.")
                .font(.caption)
                .foregroundStyle(.white.opacity(0.72))
        }
        .nutritionPanel()
    }

    private func ingredientPanel(area: KitchenArea) -> some View {
        let foods = allFoods.filter { $0.area == area }
        return VStack(alignment: .leading, spacing: 14) {
            Text(area.rawValue)
                .font(.title2.weight(.semibold))
                .foregroundStyle(.white)

            Text("Tap what you currently have. Selections are remembered for next time.")
                .font(.subheadline)
                .foregroundStyle(.white.opacity(0.78))

            LazyVGrid(columns: [GridItem(.adaptive(minimum: 125), spacing: 10)], spacing: 10) {
                ForEach(foods) { food in
                    Button {
                        let key = Self.foodKey(food.name)
                        if selected.contains(key) { selected.remove(key) }
                        else { selected.insert(key) }
                        saveSelectedFoods()
                    } label: {
                        HStack(spacing: 7) {
                            Image(systemName: selected.contains(Self.foodKey(food.name)) ? "checkmark.circle.fill" : "circle")
                            Text(food.name)
                                .multilineTextAlignment(.leading)
                                .lineLimit(2)
                                .minimumScaleFactor(0.85)
                            Spacer(minLength: 0)
                        }
                        .font(.system(size: 13, weight: .medium))
                        .foregroundStyle(.white)
                        .padding(.horizontal, 10)
                        .frame(maxWidth: .infinity, minHeight: 54, alignment: .leading)
                        .background(
                            selected.contains(Self.foodKey(food.name)) ? Color(red: 0.11, green: 0.48, blue: 0.40) : Color.white.opacity(0.15),
                            in: RoundedRectangle(cornerRadius: 12)
                        )
                    }
                    .buttonStyle(.plain)
                    .contextMenu {
                        if extraFoods.contains(where: { Self.foodKey($0.name) == Self.foodKey(food.name) }) {
                            Button("Remove from list", role: .destructive) { removeCustomFood(food) }
                        }
                    }
                }
            }

            Text("\(selected.count) ingredients selected across your kitchen")
                .font(.footnote)
                .foregroundStyle(.white.opacity(0.76))
        }
        .nutritionPanel()
    }

    private var mealPreferencesPanel: some View {
        VStack(alignment: .leading, spacing: 17) {
            Text("What are we making?")
                .font(.title2.weight(.semibold))
                .foregroundStyle(.white)

            Text("Meal")
                .font(.subheadline.weight(.semibold))
                .foregroundStyle(.white)

            HStack(spacing: 8) {
                ForEach(EatingMoment.allCases, id: \.self) { option in
                    Button(option.rawValue) { meal = option }
                        .nutritionChoice(isActive: meal == option)
                }
            }

            Text("How much time and energy?")
                .font(.subheadline.weight(.semibold))
                .foregroundStyle(.white)

            ForEach(CookingEnergy.allCases, id: \.self) { option in
                Button {
                    energy = option
                } label: {
                    HStack {
                        Image(systemName: option == .quick ? "bolt.fill" : "frying.pan.fill")
                        Text(option == .quick ? "I need something quick and easy" : "I've got time to cook")
                        Spacer()
                        if energy == option { Image(systemName: "checkmark") }
                    }
                    .padding(13)
                    .foregroundStyle(.white)
                    .background(energy == option ? Color(red: 0.11, green: 0.48, blue: 0.40) : Color.white.opacity(0.14), in: RoundedRectangle(cornerRadius: 12))
                }
                .buttonStyle(.plain)
            }

            Text("Anything else? (Optional)")
                .font(.subheadline.weight(.semibold))
                .foregroundStyle(.white)

            TextEditor(text: $additionalNotes)
                .scrollContentBackground(.hidden)
                .foregroundStyle(.white)
                .frame(minHeight: 95)
                .padding(10)
                .background(Color.black.opacity(0.40), in: RoundedRectangle(cornerRadius: 12))
                .accessibilityLabel("Additional notes or cravings")

            Text("Dictate a craving, mention leftovers, or tell ChatGPT how you're feeling. This note clears after you send a request.")
                .font(.caption)
                .foregroundStyle(.white.opacity(0.78))

            Text("We'll prioritise protein, steady-release carbohydrates, magnesium, B12 and iron, while making the meal enjoyable and practical.")
                .font(.footnote)
                .foregroundStyle(.white.opacity(0.89))
        }
        .nutritionPanel()
    }

    private func loadSavedKitchen() {
        guard !isLoaded else { return }
        isLoaded = true
        if let data = savedFoods.data(using: .utf8),
           let foods = try? JSONDecoder().decode([KitchenFood].self, from: data) {
            extraFoods = foods
        }
        if inventorySetUp {
            if let data = savedSelection.data(using: .utf8),
               let keys = try? JSONDecoder().decode([String].self, from: data) {
                selected = Set(keys)
            }
        } else {
            selected = Set(allFoods.map { Self.foodKey($0.name) })
            inventorySetUp = true
            saveSelectedFoods()
        }
    }

    static func foodKey(_ value: String) -> String {
        let simplified = value.lowercased().filter { $0.isLetter || $0.isNumber }
        switch simplified {
        case "egg", "eggs": return "eggs"
        case "tenderstembroccoli", "tenderstembrokoli": return "tenderstembroccoli"
        case "tintomatoes", "tinnedtomatoes": return "tinnedtomatoes"
        default: return simplified
        }
    }

    private func addIngredient() {
        let name = newIngredient.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !name.isEmpty else { return }
        let key = Self.foodKey(name)
        if let existing = allFoods.first(where: { Self.foodKey($0.name) == key }) {
            selected.insert(key)
            step = existing.area.step
        } else {
            extraFoods.append(KitchenFood(name: name, area: addTo))
            selected.insert(key)
            step = addTo.step
            saveCustomFoods()
        }
        saveSelectedFoods()
        newIngredient = ""
    }

    private func removeCustomFood(_ food: KitchenFood) {
        let key = Self.foodKey(food.name)
        extraFoods.removeAll { Self.foodKey($0.name) == key }
        selected.remove(key)
        saveCustomFoods()
        saveSelectedFoods()
    }

    private func saveCustomFoods() {
        if let data = try? JSONEncoder().encode(extraFoods),
           let text = String(data: data, encoding: .utf8) {
            savedFoods = text
        }
    }

    private func saveSelectedFoods() {
        if let data = try? JSONEncoder().encode(Array(selected).sorted()),
           let text = String(data: data, encoding: .utf8) {
            savedSelection = text
        }
    }

    private func discussWithChatGPT() {
        let lines = KitchenArea.allCases.compactMap { area -> String? in
            let names = allFoods.filter {
                $0.area == area && selected.contains(Self.foodKey($0.name))
            }.map(\.name)
            guard !names.isEmpty else { return nil }
            return "\(area.rawValue): \(names.joined(separator: ", "))"
        }
        guard !lines.isEmpty else { return }

        let cookingInstruction = energy == .quick
            ? "I need something quick and easy: minimal preparation, few ingredients and as little washing-up as possible."
            : "I've got time to cook: feel free to suggest something more involved or creative."
        let note = additionalNotes.trimmingCharacters(in: .whitespacesAndNewlines)
        let noteText = note.isEmpty ? "" : "\n\nMy extra note: \(note)"

        let message = """
        I'd like help making a nutritious \(meal.rawValue.lowercased()) using food I already have.

        Here is what I have available right now:
        \(lines.joined(separator: "\n"))

        My nutritional priorities are protein, steady-release carbohydrates, magnesium, vitamin B12 and iron. Please include as many of these as practical, but even one is worthwhile. I want a satisfying meal, not a restrictive diet.

        \(cookingInstruction)\(noteText)

        Please suggest two or three realistic meals using what I have. Explain briefly which of my nutritional priorities each option supports. Don't assume I have extra ingredients. Ask me a helpful question if it would make choosing easier.
        """

        UIPasteboard.general.string = message
        additionalNotes = ""
        guard let url = URL(string: "chatgpt://") else {
            showAppError = true
            return
        }
        UIApplication.shared.open(url, options: [:]) { success in
            if !success {
                DispatchQueue.main.async { showAppError = true }
            }
        }
    }
}

private extension View {
    func nutritionPanel() -> some View {
        self.padding(17)
            .frame(maxWidth: .infinity, alignment: .leading)
            .background(Color.black.opacity(0.59), in: RoundedRectangle(cornerRadius: 20))
            .overlay {
                RoundedRectangle(cornerRadius: 20)
                    .stroke(Color.white.opacity(0.24), lineWidth: 1)
            }
    }

    func nutritionChoice(isActive: Bool) -> some View {
        self.font(.system(size: 13, weight: .semibold))
            .foregroundStyle(.white)
            .frame(maxWidth: .infinity)
            .padding(.vertical, 12)
            .background(
                isActive ? Color(red: 0.11, green: 0.48, blue: 0.40) : Color.white.opacity(0.14),
                in: RoundedRectangle(cornerRadius: 11)
            )
            .buttonStyle(.plain)
    }
}
